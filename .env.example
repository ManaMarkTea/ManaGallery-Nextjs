# Optional locally: the defaults are ready for http://localhost:3000.
# Set this to the exact browser origin (no trailing slash) if changing port/domain.
APP_ORIGIN=http://localhost:3000

# Optional absolute path. Defaults to <project>/storage.
# RENDERGALLERY_DATA_DIR=C:/RenderGalleryData

# HTTPS origins automatically use Secure session cookies.
# Set true only when serving HTTPS; leave unset for local HTTP.
# SESSION_COOKIE_SECURE=true

# Only behind a reverse proxy that overwrites X-Forwarded-For.
# Without this, authentication throttles share one local bucket.
TRUST_PROXY_HEADERS=false

# Recovered Bryce5 AdSense IDs. Live ads require production + public HTTPS
# APP_ORIGIN matching the browser. Localhost shows a preview, no Google requests.
# Optional initial defaults; saved Admin > Settings values take precedence.
ADSENSE_ENABLED=false
ADSENSE_PUBLISHER_ID=ca-pub-0000000000000000
ADSENSE_SLOT_ID=0000000000
